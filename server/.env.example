# Server Configuration
PORT=5001
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/sst_lost_found

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_replace_in_production_sst_lost_and_found_2026
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_DAYS=7

# CORS / Client URL
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

# Restrict registration to institutional domain
COLLEGE_EMAIL_DOMAIN=sst.scaler.com

# Optional: Cloudinary for cloud image hosting (falls back to local filesystem if not configured)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Nodemailer for email notifications (falls back to console logging if not configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SST Lost & Found <no-reply@sst-lostfound.edu>"
